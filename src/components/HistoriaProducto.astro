---
import { Image } from "astro:assets";

interface Props {
  historia: {
    titulo: string;
    bloques: Array<
      | { tipo: "quote"; texto: string }
      | { tipo: "imagen"; src: ImageMetadata; alt?: string }
      | { tipo: "texto"; parrafos: string[] }
      | {
          tipo: "timeline";
          etapas: Array<{
            titulo: string;
            texto?: string;
            imagenes: ImageMetadata[];
          }>;
        }
      | { tipo: "testimonio"; texto: string; autor?: string }
      | { tipo: "galeria"; imagenes: ImageMetadata[] }
    >;
  };
}

const { historia } = Astro.props;

function numero(i: number): string {
  return String(i + 1).padStart(2, "0");
}
---

<section class="historia">
  <div class="container historia__contenedor">
    <header class="historia__cabecera">
      <span class="historia__kicker">Del taller</span>
      <h2 class="historia__titulo">{historia.titulo}</h2>
    </header>

    {
      historia.bloques.map((bloque) => {
        if (bloque.tipo === "quote") {
          return (
            <blockquote class="historia__quote">
              <p>{bloque.texto}</p>
            </blockquote>
          );
        }

        if (bloque.tipo === "imagen") {
          return (
            <figure class="historia__imagen paspartu">
              <div class="paspartu__ventana historia__ventana">
                <Image src={bloque.src} alt={bloque.alt ?? ""} width={1000} height={700} />
              </div>
              <span class="paspartu__filete" aria-hidden="true" />
              {bloque.alt && <figcaption>{bloque.alt}</figcaption>}
            </figure>
          );
        }

        if (bloque.tipo === "texto") {
          return (
            <div class="historia__texto">
              {bloque.parrafos.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          );
        }

        if (bloque.tipo === "timeline") {
          return (
            <ol class="historia__timeline">
              {bloque.etapas.map((etapa, j) => (
                <li class="etapa">
                  <span class="etapa__numero">{numero(j)}</span>
                  <h3 class="etapa__titulo">{etapa.titulo}</h3>
                  {etapa.texto && <p class="etapa__texto">{etapa.texto}</p>}
                  {etapa.imagenes.length === 1 && (
                    <div class="etapa__imagenes etapa__imagenes--una">
                      <div class="paspartu">
                        <div class="paspartu__ventana etapa__ventana">
                          <Image src={etapa.imagenes[0]} alt="" width={800} height={600} />
                        </div>
                        <span class="paspartu__filete" aria-hidden="true" />
                      </div>
                    </div>
                  )}
                  {etapa.imagenes.length === 2 && (
                    <div class="etapa__imagenes etapa__imagenes--dos">
                      {etapa.imagenes.map((img) => (
                        <div class="paspartu">
                          <div class="paspartu__ventana etapa__ventana">
                            <Image src={img} alt="" width={500} height={500} />
                          </div>
                          <span class="paspartu__filete" aria-hidden="true" />
                        </div>
                      ))}
                    </div>
                  )}
                  {etapa.imagenes.length > 2 && (
                    <div class="etapa__imagenes etapa__imagenes--tira">
                      {etapa.imagenes.map((img) => (
                        <div class="paspartu">
                          <div class="paspartu__ventana etapa__ventana">
                            <Image src={img} alt="" width={420} height={420} />
                          </div>
                          <span class="paspartu__filete" aria-hidden="true" />
                        </div>
                      ))}
                    </div>
                  )}
                </li>
              ))}
            </ol>
          );
        }

        if (bloque.tipo === "testimonio") {
          return (
            <figure class="historia__testimonio">
              <blockquote>
                <p>"{bloque.texto}"</p>
              </blockquote>
              {bloque.autor && <figcaption>{bloque.autor}</figcaption>}
            </figure>
          );
        }

        if (bloque.tipo === "galeria") {
          return (
            <div class="historia__galeria">
              {bloque.imagenes.map((img) => (
                <div class="paspartu">
                  <div class="paspartu__ventana historia__galeria-ventana">
                    <Image src={img} alt="" width={480} height={480} />
                  </div>
                  <span class="paspartu__filete" aria-hidden="true" />
                </div>
              ))}
            </div>
          );
        }

        return null;
      })
    }
  </div>
</section>

<style>
  .historia {
    padding: 4.5rem 0 5.5rem;
    background: var(--color-crema-clara);
    border-top: 1px solid rgba(96, 73, 50, 0.1);
  }

  /* Reja editorial: una columna de margen para números y etiquetas, y una
     columna de lectura con medida fija. Antes todo estaba centrado, bloque
     tras bloque, lo que hace que todo pese igual y cansa de leer. */
  .historia__contenedor {
    display: grid;
    grid-template-columns: 8.25rem minmax(0, 1fr);
    column-gap: 2.5rem;
    row-gap: 2.75rem;
    align-items: start;
    min-width: 0;
  }

  /* Por defecto cada bloque vive en la columna de lectura. */
  .historia__contenedor > * {
    grid-column: 2;
    min-width: 0;
  }

  .historia__cabecera {
    display: contents;
  }

  .historia__kicker {
    grid-column: 1;
    text-align: right;
    padding-top: 0.6rem;
    font-size: 0.69rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-oro-quemado);
  }

  .historia__titulo {
    grid-column: 2;
    margin: 0;
    font-size: clamp(1.85rem, 3.6vw, 2.75rem);
    letter-spacing: -0.025em;
    max-width: 20ch;
  }

  /* Cita: alineada a la columna y apoyada en un filete de oro, no centrada. */
  .historia__quote {
    margin: 0;
    padding: 0 0 0 1.6rem;
    border-left: 2px solid var(--color-amarillo-oro);
  }

  .historia__quote p {
    font-family: var(--font-titulos);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
    line-height: 1.42;
    color: var(--color-marron-oscuro);
    margin: 0;
    max-width: 24ch;
  }

  /* Imagen destacada */
  .historia__imagen {
    margin: 0;
  }

  .historia__ventana {
    aspect-ratio: 16 / 11;
  }

  .historia__imagen figcaption {
    padding-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--color-gris-morado);
  }

  /* Texto */
  .historia__texto p {
    font-size: 1.05rem;
    line-height: 1.78;
    color: #5f4c39;
    max-width: 60ch;
  }

  .historia__texto p:last-child {
    margin-bottom: 0;
  }

  /* Timeline: los números viven en el margen, sobre una línea continua. */
  .historia__timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .etapa {
    position: relative;
    padding-left: 2.5rem;
    border-left: 1px solid rgba(96, 73, 50, 0.18);
    min-width: 0;
  }

  .etapa__numero {
    position: absolute;
    left: 0;
    top: -0.35rem;
    transform: translateX(calc(-100% - 2.5rem));
    width: 8.25rem;
    text-align: right;
    font-family: var(--font-titulos);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
    color: var(--color-amarillo-oro);
    font-variant-numeric: tabular-nums;
  }

  .etapa__titulo {
    margin: 0 0 0.6rem;
    font-size: 1.4rem;
  }

  .etapa__texto {
    font-size: 1rem;
    line-height: 1.72;
    color: #5f4c39;
    margin: 0 0 1.25rem;
    max-width: 58ch;
  }

  .etapa__ventana {
    aspect-ratio: 4 / 3;
  }

  .etapa__imagenes--una {
    max-width: 26rem;
  }

  .etapa__imagenes--dos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
    max-width: 38rem;
    min-width: 0;
  }

  .etapa__imagenes--tira {
    display: flex;
    gap: 1.1rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scroll-snap-type: x proximity;
  }

  .etapa__imagenes--tira > .paspartu {
    flex: 0 0 auto;
    width: 15rem;
    scroll-snap-align: start;
  }

  /* Testimonio */
  .historia__testimonio {
    margin: 0;
    background: var(--color-crema);
    padding: 2.1rem 2.4rem;
    max-width: 41rem;
  }

  .historia__testimonio blockquote {
    margin: 0;
  }

  .historia__testimonio p {
    font-family: var(--font-titulos);
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.5;
    color: var(--color-marron-oscuro);
    margin: 0 0 0.85rem;
  }

  .historia__testimonio figcaption {
    font-size: 0.69rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-oro-quemado);
  }

  /* Galería */
  .historia__galeria {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
  }

  .historia__galeria-ventana {
    aspect-ratio: 1 / 1;
  }

  @media (max-width: 860px) {
    /* La columna de margen desaparece: en pantallas angostas robaría el ancho
       de lectura. Los números pasan a ir sobre el título. */
    .historia__contenedor {
      grid-template-columns: minmax(0, 1fr);
      column-gap: 0;
    }

    .historia__contenedor > *,
    .historia__titulo {
      grid-column: 1;
    }

    .historia__kicker {
      grid-column: 1;
      text-align: left;
      padding-top: 0;
      margin-bottom: -1.75rem;
    }

    .etapa {
      padding-left: 1.5rem;
    }

    .etapa__numero {
      position: static;
      display: block;
      transform: none;
      width: auto;
      text-align: left;
      font-size: 1.5rem;
      margin-bottom: 0.35rem;
    }
  }

  @media (max-width: 600px) {
    .etapa__imagenes--dos,
    .historia__galeria {
      grid-template-columns: 1fr;
    }
  }
</style>
